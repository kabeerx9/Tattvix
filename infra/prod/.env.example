# Copy to infra/prod/.env on the droplet (chmod 600). Never commit the real file.
# settings.py refuses to boot with DJANGO_DEBUG=false if the secret key,
# allowed hosts, or object storage look like development values.

# python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY="replace-me"
DJANGO_DEBUG="false"
# First entry is also used by the container health check as its Host header.
DJANGO_ALLOWED_HOSTS="api.tattwix.in"
CORS_ALLOWED_ORIGINS="https://tattwix.in"
# Caddy is the one proxy in front of gunicorn.
TRUSTED_PROXY_COUNT="1"

# Supabase (Mumbai) -> Connect -> Session pooler (IPv4, port 5432).
# Not the direct connection (IPv6-only on free) nor the transaction pooler (6543).
DATABASE_URL="postgresql://postgres.<project-ref>:<password>@aws-0-ap-south-1.pooler.supabase.com:5432/postgres"
DATABASE_SSL_REQUIRE="true"

# Clerk production instance for tattwix.in.
CLERK_SECRET_KEY="sk_live_replace_me"
# Clerk dashboard -> Webhooks -> endpoint https://api.tattwix.in/api/webhooks/clerk/ -> signing secret.
CLERK_WEBHOOK_SIGNING_SECRET="whsec_replace_me"
CLERK_AUTHORIZED_PARTIES="https://tattwix.in"

# AWS S3 (Mumbai). IAM user tattwix-api-object-storage, scoped to this bucket.
OBJECT_STORAGE_ENDPOINT_URL="https://s3.ap-south-1.amazonaws.com"
OBJECT_STORAGE_ACCESS_KEY_ID="replace-me"
OBJECT_STORAGE_SECRET_ACCESS_KEY="replace-me"
OBJECT_STORAGE_BUCKET_NAME="tattwix-identity-documents"
OBJECT_STORAGE_REGION="ap-south-1"
OBJECT_STORAGE_PRESIGNED_URL_TTL_SECONDS="120"
OBJECT_STORAGE_MAX_UPLOAD_BYTES="8388608"
OBJECT_STORAGE_ALLOWED_CONTENT_TYPES="image/jpeg,image/png,image/webp"

COMPANION_MINOR_AGE_YEARS="18"
HOTEL_QR_TOKEN_TTL_DAYS="365"
HOTEL_IDENTITY_MAX_ACCESS_DAYS="7"
HOTEL_IDENTITY_POST_CLOSE_GRACE_HOURS="24"

THROTTLE_PUBLIC_CHECK_IN_PER_MINUTE="30"
THROTTLE_PUBLIC_WEBHOOK_PER_MINUTE="60"
THROTTLE_IDENTITY_UPLOAD_PER_MINUTE="20"
