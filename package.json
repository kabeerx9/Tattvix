{
  "name": "tattvix",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "type": "module",
  "scripts": {
    "dev": "pnpm run storage:up && turbo -F server -F web -F native dev",
    "build": "turbo build",
    "check-types": "turbo check-types",
    "test": "node --import tsx --test scripts/*.test.ts && turbo test",
    "setup": "pnpm --filter server run setup",
    "init:project": "tsx scripts/init-project.ts",
    "doctor": "tsx scripts/doctor.ts",
    "dev:first-run": "sh scripts/dev-first-run.sh",
    "dev:native": "turbo -F native dev",
    "dev:web": "turbo -F web dev",
    "dev:server": "turbo -F server dev",
    "db:migrate": "turbo -F server migrate",
    "storage:up": "docker compose up -d minio minio-init",
    "db:up": "docker compose up -d postgres",
    "storage:down": "docker compose down",
    "storage:logs": "docker compose logs -f minio",
    "storage:check": "pnpm --filter server storage:check",
    "identity:purge": "pnpm --filter server identity:purge",
    "seed": "pnpm --filter server run seed --"
  },
  "devDependencies": {
    "@tattvix/config": "workspace:*",
    "@types/node": "catalog:",
    "tsx": "^4.20.5",
    "turbo": "^2.9.16",
    "typescript": "catalog:"
  },
  "packageManager": "pnpm@10.10.0"
}
