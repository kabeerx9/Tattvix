{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "regions": [
    "bom1"
  ],
  "installCommand": "uv sync --locked",
  "buildCommand": "python scripts/vercel_build.py",
  "functions": {
    "tattvix/wsgi.py": {
      "maxDuration": 60
    }
  },
  "crons": [
    {
      "path": "/api/cron/purge-identity-images/",
      "schedule": "30 21 * * *"
    }
  ],
  "git": {
    "deploymentEnabled": {
      "main": true,
      "**": false
    }
  }
}
